rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if current user is an admin (their own document exists)
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection
    match /admins/{userId} {
      // Anyone can read their own document (to verify admin status).
      // Existing admins can read all documents (to list all admins).
      allow read: if request.auth != null && (userId == request.auth.uid || isAdmin());
      // Only existing admins can add/remove other admins.
      allow write: if isAdmin();
    }

    // Products: public read, only admin can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pending Users: admins full access (email + whatsapp invites)
    match /pendingUsers/{documentId} {
      allow read, write, create, update, delete: if isAdmin();
    }

    // Orders: users can read/write their own orders; admins can read all.
    match /orders/{orderId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;
    }
  }
}
